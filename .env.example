PANORAFUS_PORT=3000
PANORAFUS_HOST=0.0.0.0
PANORAFUS_CHAT_PROVIDER=local
PANORAFUS_CHAT_MODEL=panorafus-docs-rag
# Optional for external chat providers:
# PANORAFUS_CHAT_API_URL=https://api.example.com/v1/chat/completions
# PANORAFUS_CHAT_API_KEY=replace-me
# Optional for a deployed GitHub webhook receiver; store the real value in a secret manager.
# PANORAFUS_GITHUB_WEBHOOK_SECRET=replace-me
